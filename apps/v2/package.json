{
  "name": "check-ins-v2",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.107.0",
    "expo": "~56.0.8",
    "expo-notifications": "~56.0.15",
    "expo-router": "~56.2.8",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "guard:no-monetization": "node ./scripts/guard-no-monetization.mjs",
    "eas:build:android": "npx eas-cli@latest build --platform android --profile production",
    "eas:build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "eas:build:preview:android": "npx eas-cli@latest build --platform android --profile preview",
    "eas:build:preview:ios": "npx eas-cli@latest build --platform ios --profile preview",
    "eas:submit:android": "npx eas-cli@latest submit --platform android --profile production",
    "eas:submit:ios": "npx eas-cli@latest submit --platform ios --profile production"
  },
  "private": true
}
